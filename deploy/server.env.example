# Copy to deploy/server.env ON THE SERVER; fill all empty values before launch.
# Domain only, without https:// or a path.
APP_DOMAIN=
# Use random hex strings (e.g. openssl rand -hex 32); no URL-reserved characters.
POSTGRES_PASSWORD=
CSRF_SECRET=
# From BotFather. Never commit this file after filling credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
# Only loopback exposure of the inner web service; HTTPS is served by Caddy.
WEB_PORT=8080
COOKIE_SECURE=true
ALLOW_DEMO_LOGIN=false
SEED_DEMO_ACCOUNTS=false
