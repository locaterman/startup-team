# For local development only. Set strong secrets in real deployments.
POSTGRES_PASSWORD=startup
CSRF_SECRET=replace-with-long-random-unique-secret
COOKIE_SECURE=false
WEB_PORT=8080
# Create a bot with BotFather; keep its token out of Git and chat messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
# Set both to false when deploying for real Telegram users.
ALLOW_DEMO_LOGIN=true
SEED_DEMO_ACCOUNTS=true
