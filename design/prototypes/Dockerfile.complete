FROM node:22-alpine AS build
WORKDIR /preview/prototypes
COPY prototypes/package.json prototypes/package-lock.json ./
RUN npm ci
COPY prototypes/ ./
COPY tokens/ ../tokens/
RUN npx tsc --noEmit && npx esbuild src/complete/invariants.ts --bundle --platform=node --format=cjs --outfile=/tmp/invariants.cjs && node /tmp/invariants.cjs && npx vite build --config vite.complete.config.ts
FROM nginx:1.27-alpine
COPY --from=build /preview/prototypes/dist /usr/share/nginx/html
COPY prototypes/nginx.complete.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
